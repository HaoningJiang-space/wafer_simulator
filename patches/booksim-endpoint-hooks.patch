+// Initialization only: sink-facing output credit account, not router inputs.
+void IQRouter::ConfigureEndpointSink(const Configuration &config, int output)
+{
+  assert(output >= 0 && output < _outputs);
+  assert(_output_channels[output]->GetSink() == nullptr);
+  assert(_next_buf[output]->Occupancy() == 0);
+  delete _next_buf[output];
+  _next_buf[output] = new BufferState(config, this, "endpoint_sink");
