new file mode 100644
index 0000000..7d6cde6
--- /dev/null
+++ b/rapidchiplet/booksim2/src/trace_dependency_graph.hpp
@@ -0,0 +1,31 @@
+// Flat, immutable-after-loading workload topology. Mutable dependency counts,
+// timestamps and resource state belong to the execution backend, not this graph.
+#ifndef WAFER_TRACE_DEPENDENCY_GRAPH_HPP
+#define WAFER_TRACE_DEPENDENCY_GRAPH_HPP
+
+#include <cstddef>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+struct TraceDependencyGraph {
+    std::vector<size_t> offsets;
+    std::vector<long> successors;
+
+    // First store row lengths in offsets[id+1], then seal the allocation once.
+    // Rows are populated in original edge order; never sort for convenience.
+    void AllocateRows() {
+        for (size_t i = 1; i < offsets.size(); ++i) {
+            if (offsets[i] > std::numeric_limits<size_t>::max() - offsets[i-1])
+                throw std::overflow_error("Trace dependency offset overflow");
+            offsets[i] += offsets[i-1];
+        }
+        successors.resize(offsets.back());
+    }
+
+    size_t StorageBytes() const {
+        return offsets.size() * sizeof(size_t) + successors.size() * sizeof(long);
+    }
+};
+
+#endif
diff --git a/rapidchiplet/booksim2/src/trace_frontier_profile.hpp b/rapidchiplet/booksim2/src/trace_frontier_profile.hpp
new file mode 100644
index 0000000..02927ea
--- /dev/null
+++ b/rapidchiplet/booksim2/src/trace_frontier_profile.hpp
@@ -0,0 +1,47 @@
+// Optional aggregate instrumentation. This does not schedule execution.
+#ifndef WAFER_TRACE_FRONTIER_PROFILE_HPP
+#define WAFER_TRACE_FRONTIER_PROFILE_HPP
+
+#include <array>
+#include <cstdint>
+#include <nlohmann/json.hpp>
+
+struct TraceWidthHistogram {
+    // 0 is zero; bin k>0 is [2^(k-1), 2^k-1]. No per-event allocation.
+    std::array<uint64_t, 65> bins{};
+    uint64_t samples = 0, total = 0, maximum = 0;
+    void Add(uint64_t width) {
+        unsigned bin = 0;
+        for (uint64_t value = width; value; value >>= 1) ++bin;
+        ++bins[bin];
+        ++samples;
+        total += width;
+        if (width > maximum) maximum = width;
+    }
+    nlohmann::json Report() const {
+        return {{"bins", bins}, {"samples", samples}, {"total", total},
+                {"maximum", maximum},
+                {"bin_definition", "0: zero; k>0: [2^(k-1), 2^k-1]"}};
+    }
+};
+
+struct TraceFrontierProfile {
+    TraceWidthHistogram successor_edges, newly_ready, completions_per_active_cycle;
+    long active_cycle = -1;
+    uint64_t cycle_completions = 0;
+    void Record(long observation_cycle, uint64_t edges, uint64_t ready) {
+        if (active_cycle != observation_cycle) {
+            Flush();
+            active_cycle = observation_cycle;
+        }
+        ++cycle_completions;
+        successor_edges.Add(edges);
+        newly_ready.Add(ready);
+    }
+    void Flush() {
+        if (cycle_completions) completions_per_active_cycle.Add(cycle_completions);
+        cycle_completions = 0;
+    }
+};
+
+#endif
