diff --git a/rapidchiplet/booksim2/src/node_reuse.hpp b/rapidchiplet/booksim2/src/node_reuse.hpp
new file mode 100644
index 0000000..d82af60
--- /dev/null
+++ b/rapidchiplet/booksim2/src/node_reuse.hpp
@@ -0,0 +1,53 @@
+#ifndef BOOKSIM_NODE_REUSE_HPP
+#define BOOKSIM_NODE_REUSE_HPP
+
+#include <map>
+#include <set>
+#include <utility>
+#include <vector>
+
+// C++17 node handles retain the existing ordered-container semantics while
+// avoiding a malloc/free pair for each clear/insert cycle. Pools own extracted
+// nodes exclusively; container destruction and pool destruction release them.
+template<class Container>
+void RecycleNodes(Container & values,
+                  std::vector<typename Container::node_type> & pool) {
+  while (!values.empty()) pool.push_back(values.extract(values.begin()));
+}
+
+template<class Key, class Value>
+void ReuseMapEntry(std::map<Key, Value> & values,
+                   std::vector<typename std::map<Key, Value>::node_type> & pool,
+                   const Key & key, const Value & value) {
+  if (pool.empty()) {
+    values[key] = value;
+    return;
+  }
+  auto node = std::move(pool.back());
+  pool.pop_back();
+  node.key() = key;
+  node.mapped() = value;
+  auto result = values.insert(std::move(node));
+  if (!result.inserted) {
+    result.position->second = value;
+    pool.push_back(std::move(result.node));
+  }
+}
+
+template<class Key>
+void ReuseSetEntry(std::set<Key> & values,
+                   std::vector<typename std::set<Key>::node_type> & pool,
+                   const Key & key) {
+  if (pool.empty()) {
+    values.insert(key);
+    return;
+  }
+  auto node = std::move(pool.back());
+  pool.pop_back();
+  node.value() = key;
+  auto result = values.insert(std::move(node));
+  // A duplicate remains one credit, and its unused node stays reusable.
+  if (!result.inserted) pool.push_back(std::move(result.node));
+}
+
+#endif
