+using RoutingNeighbors = std::map<int, std::tuple<int, int, int>>;
+using RoutingTopology = std::vector<std::map<int, RoutingNeighbors>>;
+
+// Routers without attached endpoints have no entry in topology[0]. Preserve
+// the old by-value operator[] empty-adjacency behavior without mutating or
+// copying the shared topology on every flit route.
+inline const RoutingNeighbors& routing_neighbors(const RoutingTopology& topology,
+                                                 unsigned domain, int router) {
+    static const RoutingNeighbors empty;
+    const auto& layer = topology.at(domain);
+    const auto found = layer.find(router);
+    return found == layer.end() ? empty : found->second;
+}
