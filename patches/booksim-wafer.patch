+// Completion semantics for fixed-state application DAGs. Compute nodes are
+// timed events; all message flits must arrive before consumers become ready.
+void TrafficManager::_HandlePacketWithZeroDependencies(long id) {
+    if (trace_scheduled.at(id)) Error("Instruction scheduled twice");
+    trace_scheduled[id] = 1;
+    long ready = max(msg_cycle.at(id), global_current_cycle);
+    msg_ready_cycle[id] = ready;
+    long start = ready;
+    int cpu = msg_cpu_resource.at(id);
+    msg_cpu_predecessor[id] = -1;
+    if (cpu >= 0) {
+        // Fixed-duration GOAL lanes, FCFS in dependency-ready callback order.
+        // Network sends use a zero-overhead issue slot; their network latency
+        // does not occupy the CPU lane. This is an explicit target policy.
+        start = max(start, cpu_free_cycle[cpu]);
+        if (start > ready) msg_cpu_predecessor[id] = cpu_owner.at(cpu);
+        if (msg_duration.at(id) > 0) {
+            cpu_free_cycle[cpu] = start + msg_duration.at(id);
+            cpu_owner[cpu] = id;
+        }
+    }
+    msg_start_cycle[id] = start;
+    if (msg_ignore.at(id)) {
+        compute_completions.push(make_pair(start + msg_duration.at(id), id));
+    } else {
+        ready_messages[msg_source.at(id)].push(make_pair(start, id));
+    }
+}
+
+void TrafficManager::_CompleteTraceInstruction(long id, long cycle) {
+    if (trace_completed.at(id)) Error("Instruction completed twice");
+    trace_completed[id] = 1;
+    msg_finish_cycle[id] = cycle;
+    rc_trace_finish_cycle = max(rc_trace_finish_cycle, cycle);
+    rc_trace_instructions_simulated++;
+    dependency_ready_frontier.clear();
+    const size_t begin = trace_dependencies.offsets.at(id);
+    const size_t end = trace_dependencies.offsets.at(id + 1);
+    for (size_t edge = begin; edge < end; ++edge) {
+        const long successor = trace_dependencies.successors[edge];
+        msg_cycle[successor] = max(msg_cycle[successor], cycle);
+        if (--msg_deps_left[successor] < 0) Error("Negative dependency count");
+        if (msg_deps_left[successor] == 0) dependency_ready_frontier.push_back(successor);
+    }
+    if (!rc_trace_dependency_profile.empty())
+        trace_frontier_profile.Record(global_current_cycle, end - begin, dependency_ready_frontier.size());
+    // Stable compaction: submit in original successor order before processing
+    // ANY other completion. The callback only schedules future events; it must
+    // not recursively complete instructions. Even same-cycle completions cannot
+    // be merged arbitrarily because CPU reservations and heap ties observe order.
+    for (long successor : dependency_ready_frontier) _HandlePacketWithZeroDependencies(successor);
+}
+
+void TrafficManager::_WriteTraceReport(bool complete) {
+    if (!rc_trace_dependency_profile.empty()) {
+        trace_frontier_profile.Flush();
+        json profile = {
+            {"schema_version", 1}, {"complete", complete},
+            {"instructions_expected", rc_trace_instructions},
+            {"instructions_completed", rc_trace_instructions_simulated},
+            {"initial_roots", trace_initial_roots},
+            {"static_edges", trace_dependencies.successors.size()},
+            {"csr_storage_bytes", trace_dependencies.StorageBytes()},
+            {"row_offset_bytes", sizeof(size_t)}, {"successor_id_bytes", sizeof(long)},
+            {"successor_edges_per_completion", trace_frontier_profile.successor_edges.Report()},
+            {"newly_ready_per_completion", trace_frontier_profile.newly_ready.Report()},
+            {"completions_per_active_cycle", trace_frontier_profile.completions_per_active_cycle.Report()},
+            {"scope", "Workload dependency processing only; same-cycle events may remain causally ordered"}
+        };
+        ofstream profile_output(rc_trace_dependency_profile);
+        if (!profile_output) Error("Cannot write trace dependency profile");
+        profile_output << profile.dump(2) << endl;
+        if (!profile_output) Error("Failed writing trace dependency profile");
+    }
+    if (rc_trace_report.empty()) return;
+    json report;
+    report["schema_version"] = 1;
+    report["complete"] = complete;
+    report["application_cycles"] = rc_trace_finish_cycle;
+    report["observation_cycle"] = global_current_cycle;
+    report["network_steps"] = _time;
+    report["instructions_expected"] = rc_trace_instructions;
+    report["instructions_completed"] = rc_trace_instructions_simulated;
+    report["messages_completed"] = rc_trace_messages_simulated;
+    report["flits_ejected"] = rc_trace_ejected_flits;
+    report["tagged_last_flit_arrived_early"] = rc_trace_tagged_last_early;
+    report["events"] = json::array();
+    ofstream event_stream;
+    if (!rc_trace_events_file.empty()) {
+        event_stream.open(rc_trace_events_file);
+        if (!event_stream) Error("Cannot write trace events");
+        report["events_file"] = rc_trace_events_file;
+    }
+    for (size_t id = 0; id < msg_source.size(); ++id) {
+        json event = {{"id", id}, {"completed", trace_completed.at(id) != 0},
+                      {"ready_cycle", msg_ready_cycle.at(id)},
+                      {"start_cycle", msg_start_cycle.at(id)},
+                      {"cpu_predecessor", msg_cpu_predecessor.at(id)},
+                      {"finish_cycle", msg_finish_cycle.at(id)},
+                      {"flits_remaining", msg_flits_remaining.at(id)}};
+        if (!msg_ignore.at(id)) {
+            event["generated_cycle"] = msg_generate_cycle.at(id);
+            event["first_inject_cycle"] = msg_first_inject.at(id);
+            event["last_inject_cycle"] = msg_last_inject.at(id);
+            event["first_eject_cycle"] = msg_first_eject.at(id);
+        }
+        if (event_stream.is_open()) event_stream << event.dump() << '\n';
+        else report["events"].push_back(event);
+    }
+    if (event_stream.is_open()) {
+        event_stream.flush();
+        if (!event_stream) Error("Failed writing trace events");
+        event_stream.close();
+    }
+    ofstream output(rc_trace_report);
+    if (!output) Error("Cannot write complete-trace report");
+    output << report.dump(2) << endl;
+}
+
+int TrafficManager::_RunCompleteTrace() {
+    _ClearStats();
+    global_current_cycle = 0;
+    const long cycle_limit = static_cast<long>(_sample_period) * 1000;
+    const auto start = chrono::steady_clock::now();
+    long next_progress = 60;
+    while (true) {
+        while (!compute_completions.empty() && compute_completions.top().first <= global_current_cycle) {
+            const auto event = compute_completions.top();
+            compute_completions.pop();
+            _CompleteTraceInstruction(event.second, event.first);
+        }
+        if (rc_trace_instructions_simulated == rc_trace_instructions) {
+            _WriteTraceReport(true);
+            return 0;
+        }
+        const auto seconds = chrono::duration_cast<chrono::seconds>(chrono::steady_clock::now() - start).count();
+        if (seconds >= next_progress) {
+            cout << "TRACE_PROGRESS seconds=" << seconds << " cycle=" << global_current_cycle
+                 << " instructions=" << rc_trace_instructions_simulated << "/" << rc_trace_instructions
+                 << " messages=" << rc_trace_messages_simulated << " flits=" << rc_trace_ejected_flits << endl;
+            next_progress = seconds + 60;
+        }
+        if (global_current_cycle >= cycle_limit || seconds >= rc_trace_time_out) {
+            _WriteTraceReport(false);
+            return 3;
+        }
+        bool network_idle = Credit::OutStanding() == 0;
+        for (int c = 0; c < _classes; ++c) network_idle &= _total_in_flight_flits[c].empty();
+        if (network_idle) {
+            long next_event = cycle_limit;
+            bool event_exists = false;
+            if (!compute_completions.empty()) {
+                next_event = min(next_event, compute_completions.top().first);
+                event_exists = true;
+            }
+            for (const auto & queue : ready_messages) {
+                if (!queue.second.empty()) {
+                    next_event = min(next_event, queue.second.top().first);
+                    event_exists = true;
+                }
+            }
+            if (!event_exists) {
+                _WriteTraceReport(false);
+                return 1; // cyclic/unreachable DAG, not a completed application
+            }
+            if (rc_trace_skip_idle && next_event > global_current_cycle) {
+                global_current_cycle = next_event;
+                continue;
+            }
+        }
+        const int code = _Step();
+        if (code) { _WriteTraceReport(false); return code; }
+        global_current_cycle++;
+    }
 }
 
 
