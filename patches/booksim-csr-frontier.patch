 void TrafficManager::_WriteTraceReport(bool complete) {
+    if (!rc_trace_dependency_profile.empty()) {
+        trace_frontier_profile.Flush();
+        json profile = {
+            {"schema_version", 1}, {"complete", complete},
+            {"instructions_expected", rc_trace_instructions},
+            {"instructions_completed", rc_trace_instructions_simulated},
+            {"initial_roots", trace_initial_roots},
+            {"static_edges", trace_dependencies.successors.size()},
+            {"csr_storage_bytes", trace_dependencies.StorageBytes()},
+            {"row_offset_bytes", sizeof(size_t)}, {"successor_id_bytes", sizeof(long)},
+            {"successor_edges_per_completion", trace_frontier_profile.successor_edges.Report()},
+            {"newly_ready_per_completion", trace_frontier_profile.newly_ready.Report()},
+            {"completions_per_active_cycle", trace_frontier_profile.completions_per_active_cycle.Report()},
+            {"scope", "Workload dependency processing only; same-cycle events may remain causally ordered"}
+        };
+        ofstream profile_output(rc_trace_dependency_profile);
+        if (!profile_output) Error("Cannot write trace dependency profile");
+        profile_output << profile.dump(2) << endl;
+        if (!profile_output) Error("Failed writing trace dependency profile");
+    }
     if (rc_trace_report.empty()) return;
     json report;
     report["schema_version"] = 1;
